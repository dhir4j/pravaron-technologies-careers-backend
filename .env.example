APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///pravaron_careers.sqlite3
FRONTEND_URL=http://localhost:3000
CAREERS_PUBLIC_URL=https://careers.pravarontechnologies.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://careers.pravarontechnologies.com
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
MAX_RESUME_SIZE_MB=8
UPLOAD_FOLDER=instance/uploads
EMAIL_FROM_ADDRESS=careers@example.com
EMAIL_REPLY_TO=careers@example.com
CAREERS_MAIL_IMAP_HOST=imappro.zoho.in
CAREERS_MAIL_IMAP_PORT=993
CAREERS_MAIL_USERNAME=mailbox@example.com
CAREERS_MAIL_APP_PASSWORD=<set-in-environment>
CAREERS_MAIL_MAILBOX=INBOX
CAREERS_MAIL_FETCH_LIMIT=200
DEEPSEEK_API_KEY=change-me
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ANALYSIS_MAX_RESUME_CHARS=12000
DEEPSEEK_ANALYSIS_TIMEOUT_SECONDS=60
